        "synthetic": true,
        "source_note": "Author-created fixture for state-handling demonstration."
      },
      "expect": {
        "terminal": "complete",
        "decision": "state_updated"
      }
    },
    {
      "id": "P4",
      "type": "user_message",
      "payload": {
        "text": "Как указать использование ИИ в этом задании?"
      },
      "expect": {
        "terminal": "complete",
        "decision": "answer",
        "lang": "ru",
        "must_cite_sources": [
          "DEMO_AI_POLICY"
        ]
      }
    },
    {
      "id": "P5",
      "type": "user_message",
      "payload": {
