{
  "id": "synthetic-progressive-v1",
  "description": "Author-defined synthetic smoke replay only. No real university policy, external evaluation or legal authority. Receipt of a synthetic syllabus records context, not interpretation of its content.",
  "events": [
    {
      "id": "P1",
      "type": "user_message",
      "partial": true,
      "payload": {},
      "expect": {
        "terminal": "partial",
        "decision": null
      }
    },
    {
      "id": "P2",
      "type": "user_message",
      "payload": {
        "text": "What disclosure is required at Demo University for an assignment?"
      },
      "expect": {
        "terminal": "complete",
        "decision": "answer",
        "lang": "en",
        "must_cite_sources": [
          "DEMO_AI_POLICY"
        ]
      }
    },
    {
      "id": "P3",
      "type": "document",
